# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB Atlas in Production, Local in Development)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/personal_finance_tracker?retryWrites=true&w=majority
# or for local development:
MONGO_URI=mongodb://127.0.0.1:27017/personal_finance_tracker

# JWT Authentication Secret (Use a strong random string)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRE=30d

# Frontend Client URL for CORS (e.g., https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173
